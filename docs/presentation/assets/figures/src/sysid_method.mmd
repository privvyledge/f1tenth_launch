flowchart LR
  BAG[["driven bag<br/><i>structured excitation, no images</i>"]]

  subgraph CMD["what was commanded"]
    C1["commands/servo/position"]
    C2["commands/motor/speed"]
  end
  subgraph REF["independent references"]
    R1["gyro-z, TF-corrected<br/><i>steering</i>"]
    R2["odom/rf2o"]
    R3["visual_slam odometry"]
    R4["tape measure<br/><i>the only absolute one</i>"]
  end

  FIT{{"fit_actuators.py<br/>scored in <b>servo units</b>, not radians"}}
  OUT1["steering gain and offset"]
  OUT2["speed gain, erpm per m/s"]
  OUT3["deadband, carried in ERPM"]

  BAG --> C1 & C2 & R1 & R2 & R3
  C1 --> FIT
  C2 --> FIT
  R1 --> FIT
  R2 --> FIT
  R3 --> FIT
  R4 --> FIT
  FIT --> OUT1 & OUT2 & OUT3

  classDef cmd fill:#eef4fa,stroke:#0353a4,stroke-width:1.5px,color:#14181d;
  classDef ref fill:#fdf3e3,stroke:#9a6a00,stroke-width:1.5px,color:#14181d;
  classDef fit fill:#f5e7e7,stroke:#b3282d,stroke-width:2px,color:#14181d;
  class C1,C2 cmd;
  class R1,R2,R3,R4 ref;
  class FIT,OUT1,OUT2,OUT3 fit;
